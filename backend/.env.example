# ---------------------------------------------------------------------------
# ABTalks Interview Intelligence -- backend configuration
#
# Everything here is OPTIONAL. With an empty .env the app boots, serves the
# full API, and runs complete interviews using the deterministic local
# strategist. Add keys to turn on the real models.
# ---------------------------------------------------------------------------

ENVIRONMENT=local
DEBUG=false
LOG_LEVEL=INFO
LOG_JSON=false

# Comma-separated. Add your deployed frontend origin here.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---------------------------------------------------------------------------
# AI providers
#
# Grok is primary, Gemini 2.5 Flash is the fallback. If Grok times out, errors,
# rate-limits, or trips its circuit breaker, the router switches to Gemini
# mid-interview without the candidate noticing. If both are unavailable the
# local strategist keeps the session alive.
#
# Configure at least one for a genuinely good interview.
# ---------------------------------------------------------------------------

# https://console.x.ai
XAI_API_KEY=
XAI_MODEL=grok-4-fast-reasoning

# https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

AI_REQUEST_TIMEOUT_S=45
AI_MAX_ATTEMPTS=3
AI_CIRCUIT_FAIL_THRESHOLD=3
AI_CIRCUIT_RESET_S=60

# ---------------------------------------------------------------------------
# Persistence
#
# Leave MONGODB_URI empty to run on the in-memory store -- identical behaviour,
# no durability. Set it to persist sessions, reports and analytics.
# ---------------------------------------------------------------------------

MONGODB_URI=
MONGODB_DB=abtalks_interview

# ---------------------------------------------------------------------------
# Interview policy
# ---------------------------------------------------------------------------

INTERVIEW_MIN_TURNS=8
INTERVIEW_MAX_TURNS=14
INTERVIEW_ANSWER_MAX_CHARS=8000
